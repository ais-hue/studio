{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local testing only (npm run dev). Same as wrangler.jsonc minus the live routes.
  "name": "studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Created automatically by Cloudflare on the first deploy. Studio builds its own tables on first run.
  "d1_databases": [
    { "binding": "DB", "database_name": "studio", "migrations_dir": "migrations" }
  ],
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ROOT_DOMAIN": "aisling.online",
    // Filled in after Cloudflare Access is set up for studio.aisling.online. Until then the studio refuses every sign-in.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_AUTH": "0"
  },
  "observability": { "enabled": true }
  // Secret, added in the Cloudflare dashboard (never committed): RESEND_API_KEY
}
