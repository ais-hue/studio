{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local testing only (npm run dev). Same as wrangler.jsonc minus the live routes.
  "name": "studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Created automatically by Cloudflare on the first deploy. Studio builds its own tables on first run.
  // File library. Created automatically on deploy (R2 must be switched on in the account).
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "studio-files" }
  ],
  // Sign-in tokens for the Claude connector. Created automatically on deploy.
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "studio", "migrations_dir": "migrations" }
  ],
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ROOT_DOMAIN": "aisling.online",
    // Who can sign in to the studio (comma-separated).
    "ADMIN_EMAILS": "hello@aisling.online",
    // Optional: Cloudflare Access as a second way in. Studio uses its own email-link sign-in.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_AUTH": "0"
  },
  "observability": { "enabled": true }
  // Secret, added in the Cloudflare dashboard (never committed): RESEND_API_KEY
}
