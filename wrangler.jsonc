{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "proof", "database_id": "local-dev-placeholder", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ROOT_DOMAIN": "aisling.online",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_AUTH": "0"
  },
  "observability": { "enabled": true }
  // Routes (added at go-live):
  //   "routes": [{ "pattern": "*.aisling.online/*", "zone_name": "aisling.online" }]
  // Secret (added at go-live):  RESEND_API_KEY
}
